{
  "build": {
    "env": {
      "VERCEL_PREVIEW_COMMENTS_ENABLED": "0"
    }
  },
  "crons": [
    {
      "path": "/api/cron/process-scheduled-emails",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/booking-review-emails",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/membership-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/weekly-matchmaking",
      "schedule": "0 7 * * 2"
    }
  ]
}
