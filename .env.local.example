# Copy to .env.local and fill in values.

# Stripe (membership checkout) — use test keys + test Price IDs locally/Preview; live in Production.
NEXT_PUBLIC_ENABLE_STRIPE=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One Stripe Price per role (full price; no Stripe promotion codes in Checkout)
STRIPE_PARENT_PRICE_ID=
STRIPE_FRIEND_PRICE_ID=

# Deprecated for checkout (optional legacy webhook reverse-lookup only)
# STRIPE_PRICE_PARENT_1M=
# STRIPE_PRICE_PARENT_3M=
# STRIPE_PRICE_PARENT_12M=
# STRIPE_PRICE_FRIEND_1M=
# STRIPE_PRICE_FRIEND_3M=
# STRIPE_PRICE_FRIEND_12M=

# Site — canonical production URL for emails/share links (optional on Preview; auth uses current origin)
NEXT_PUBLIC_SITE_URL=

# Supabase (service role required for Stripe webhooks + platform access code redemption)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Dashboard → Authentication → URL Configuration → Redirect URLs
# Add all of the following (keep production URLs when adding Preview):
#   https://www.staywithmypet.ee/**
#   https://staywithmypet.ee/**
#   https://staywithmypet-git-development-kushelec-datas-projects.vercel.app/**
#   http://localhost:3000/**
# Site URL (Authentication): https://www.staywithmypet.ee

# Internal webhook health probe (optional)
# CRON_SECRET=
# EMAIL_INTERNAL_SECRET=
